{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "`uv add` is deliberately absent: the runtime is stdlib-only, so adding a dependency is a decision that should require an explicit prompt rather than a pre-approval.",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv lock:*)",
      "Bash(uv build:*)",
      "Bash(make:*)",
      "Bash(ruff:*)",
      "Bash(basedpyright:*)",
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
